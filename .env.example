# Daytona
DAYTONA_API_KEY=dtn_xxxx
WITNESS_SNAPSHOT=                 # scripts/build_snapshot.py の後に orbital-witness-geo
WITNESS_RESTRICT_NETWORK=1        # 1: データ取得先以外への通信を遮断

# Copernicus Data Space（SAR）: dataspace.copernicus.eu で OAuth クライアントを作成
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_DAYTONA_SECRET=              # Daytona 組織 Secret 名を入れると平文をサンドボックスに渡さない

# Tavily / Nosana / AgentField / CodeAF（Part 4 で使用）
TAVILY_API_KEY=tvly-xxxx
NOSANA_BASE_URL=https://xxxxxxxx.node.k8s.prd.nos.ci/v1
NOSANA_MODEL=qwen-vl
NOSANA_API_KEY=none
AGENTFIELD_SERVER=http://localhost:8080
OPENROUTER_API_KEY=sk-or-xxxx
CODEAF_VIA_NOSANA=0
